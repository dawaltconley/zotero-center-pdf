{
  "name": "zotero-center-pdf",
  "type": "module",
  "version": "0.1.5",
  "description": "Zotero plugin to center a PDF in the view when navigating between pages.",
  "config": {
    "addonName": "Center PDF",
    "addonID": "center-pdf@dylan.ac",
    "addonRef": "center-pdf",
    "addonInstance": "CenterPdf",
    "prefsPrefix": "extensions.zotero.center-pdf"
  },
  "scripts": {
    "dev": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "vitest run"
  },
  "author": "Dylan Awalt-Conley",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^22.20.1",
    "esbuild-sass-plugin": "^3.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0",
    "vitest": "^3.2.6",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawaltconley/zotero-center-pdf.git"
  },
  "keywords": [
    "zotero",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/dawaltconley/zotero-center-pdf/issues"
  },
  "homepage": "https://github.com/dawaltconley/zotero-center-pdf#readme",
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
